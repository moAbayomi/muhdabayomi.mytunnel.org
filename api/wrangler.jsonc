{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "WEB_ORIGIN": "http://localhost:4321",
    "DATABASE_URL": "",
    "ADMIN_PASSWORD": "",
    "AUTH_SECRET": "",
    "ENVIRONMENT": ""
  }
}
