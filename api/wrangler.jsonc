{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "WEB_ORIGIN": "http://localhost:4321",
    "DATABASE_URL": "",
    "ADMIN_PASSWORD": "",
    "AUTH_SECRET": "",
    "DEPLOY_HOOK_URL": "",
    "R2_PUBLIC_URL": "",
    "ENVIRONMENT": ""
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "wiki-media"
    }
  ]
}
