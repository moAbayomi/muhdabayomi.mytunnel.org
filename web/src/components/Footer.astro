---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-rule py-6 font-mono text-meta text-muted">
  <nav class="mb-4 flex flex-wrap gap-x-5 gap-y-1">
    <a href="/about" class="bracket-link">about</a>
    <a href="/projects" class="bracket-link">projects</a>
    <a href="/resume" class="bracket-link">resume</a>
    <a href="/contact" class="bracket-link">contact</a>
    <a href="/directory" class="bracket-link">notes</a>
    <a href="/rss.xml" class="bracket-link">rss</a>
  </nav>

  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <span>© {year} mo abayomi</span>
    <span data-local-time>— in Osun, Nigeria</span>
  </div>
</footer>

<script>
  const el = document.querySelector("[data-local-time]");

  if (el) {
    const format = new Intl.DateTimeFormat("en-US", {
      timeZone: "Africa/Lagos",
      hour: "numeric",
      minute: "2-digit",
    });

    const tick = () => {
      const time = format.format(new Date()).replace(/\s?(AM|PM)/i, "");
      el.textContent = `${time} in Osun, Nigeria`;
    };

    tick();
    setInterval(tick, 30_000);
  }
</script>
