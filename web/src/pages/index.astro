---
import Base from "../layouts/Base.astro";
import BracketedLink from "../components/BracketedLink.astro";
---

<Base>
  <section>
    <h1 class="text-h1">mo abayomi.</h1>
    <p class="mt-4 font-mono text-meta text-muted">tinkerer · osun, nigeria</p>

    <p class="mt-12 max-w-prose text-lede">
      I'm a developer building things on the web. This is my wiki: a place for notes,
      projects, and things I'm still working out.
    </p>

    <p class="mt-6 max-w-prose text-body text-muted">
      The directory and notes arrive in the next phase. For now,
      <BracketedLink href="/styleguide" label="the styleguide" /> shows the design system.
    </p>
  </section>
</Base>
